<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Calculadora Básica</title>
  <style>
    body { font-family: sans-serif; display: flex; justify-content: center; align-items: center; height: 100vh; background: #121212; margin: 0; }
    .calc { background: #1e1e24; padding: 20px; border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.5); }
    #pantalla { width: 100%; height: 50px; background: #000; color: #00ffcc; font-size: 1.5rem; text-align: right; padding: 10px; box-sizing: border-box; border: none; margin-bottom: 15px; border-radius: 6px; }
    .grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }
    button { padding: 15px; font-size: 1.1rem; border: none; background: #2e2e38; color: #fff; border-radius: 6px; cursor: pointer; }
    button:hover { background: #3e3e4a; }
    button.op { background: #ff5e36; }
    button.op:hover { background: #e04e28; }
  </style>
</head>
<body>
  <div class="calc">
    <input type="text" id="pantalla" readonly>
    <div class="grid">
      <button onclick="limpiar()">C</button>
      <button onclick="agregar('/')">/</button>
      <button onclick="agregar('*')">*</button>
      <button onclick="agregar('-')" class="op">-</button>
      <button onclick="agregar('7')">7</button>
      <button onclick="agregar('8')">8</button>
      <button onclick="agregar('9')">9</button>
      <button onclick="agregar('+')" class="op">+</button>
      <button onclick="agregar('4')">4</button>
      <button onclick="agregar('5')">5</button>
      <button onclick="agregar('6')">6</button>
      <button onclick="calcular()" class="op">=</button>
      <button onclick="agregar('1')">1</button>
      <button onclick="agregar('2')">2</button>
      <button onclick="agregar('3')">3</button>
      <button onclick="agregar('0')">0</button>
    </div>
  </div>
  <script>
    const p = document.getElementById('pantalla');
    function agregar(val) { p.value += val; }
    function limpiar() { p.value = ''; }
    function calcular() {
      try { p.value = eval(p.value); }
      catch { p.value = 'Error'; }
    }
  </script>
</body>
</html>
